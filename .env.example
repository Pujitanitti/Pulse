# SQLite — zero setup, no server or Docker required. This resolves to
# prisma/dev.db (paths are relative to prisma/schema.prisma, not the
# project root). Copy this file to .env — no edits needed to get running.
DATABASE_URL="file:./dev.db"

# Session signing secret — generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-real-32-byte-random-secret"

# Cookie name for the session token (safe default, no need to change)
SESSION_COOKIE_NAME="pulse_session"

# Node environment
NODE_ENV="development"
